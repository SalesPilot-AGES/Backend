@startuml
!theme plain
hide circle
skinparam linetype ortho

entity "companies" as companies {
  * id : uuid <<PK>>
  --
  name : varchar
  tax_id : varchar
  phone : varchar
  address : varchar
  active : boolean
  created_at : datetime
  updated_at : datetime
}

' TO-DO: needs to discuss authentication strategy before defining this table
