<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.salespilot</groupId>
        <artifactId>api</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>infrastructure</artifactId>
    <name>infrastructure</name>
    <description>Infrastructure layer - JPA implementations, external services, Spring config</description>

    <properties>
        <hibernate.tools.version>7.2.3.Final</hibernate.tools.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.salespilot</groupId>
            <artifactId>domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.salespilot</groupId>
            <artifactId>application</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.hibernate.tool</groupId>
                <artifactId>hibernate-tools-maven</artifactId>
                <version>${hibernate.tools.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.hibernate.tool</groupId>
                        <artifactId>hibernate-tools-orm</artifactId>
                        <version>${hibernate.tools.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${postgresql.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <propertyFile>${project.basedir}/src/main/hibernate/hibernate.properties</propertyFile>
                    <revengFile>${project.basedir}/src/main/hibernate/reveng.xml</revengFile>
                    <packageName>com.salespilot.api.infrastructure.persistence.jpa.entity</packageName>
                    <outputDirectory>${project.basedir}/src/main/java</outputDirectory>
                    <ejb3>true</ejb3>
                    <jdk5>true</jdk5>
                    <createCollectionForForeignKey>true</createCollectionForForeignKey>
                    <createManyToOneForForeignKey>true</createManyToOneForForeignKey>
                    <detectManyToMany>true</detectManyToMany>
                    <detectOneToOne>true</detectOneToOne>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
